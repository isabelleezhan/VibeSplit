# Copy this file to .env and fill in real values.

# --- App ---
APP_ENV=development
SECRET_KEY=changeme

# --- Spotify OAuth (authorization code flow) ---
# Redirect URI must use 127.0.0.1, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Where to send the browser after a successful login — the Vite dev server.
FRONTEND_URL=http://127.0.0.1:5173

# --- Database ---
# Run `docker compose up -d` to start Postgres locally with these credentials.
DATABASE_URL=postgresql+asyncpg://vibesplit:vibesplit@localhost:5432/vibesplit

# --- Cache / job queue backing ---
REDIS_URL=redis://localhost:6379/0

# --- LLM API (genre/vibe tagging, cluster labeling + outlier detection) ---
# Free tier, no credit card — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
